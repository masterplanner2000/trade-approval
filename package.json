{
  "name": "trade-approval",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "service": "node service/server.mjs",
    "service:phone": "node --env-file=.env.local service/server.mjs",
    "market:refresh": ".venv-ibkr-10.49/bin/python service/alpaca_market_cache.py refresh",
    "market:status": ".venv-ibkr-10.49/bin/python service/alpaca_market_cache.py status",
    "market:scan": ".venv-ibkr-10.49/bin/python service/alpaca_market_cache.py scan",
    "market:aggressive:refresh": ".venv-ibkr-10.49/bin/python service/aggressive_shadow_scanner.py refresh",
    "market:aggressive:status": ".venv-ibkr-10.49/bin/python service/aggressive_shadow_scanner.py status",
    "market:aggressive:scan": ".venv-ibkr-10.49/bin/python service/aggressive_shadow_scanner.py scan",
    "market:intraday:profiles": ".venv-ibkr-10.49/bin/python service/intraday_volume_profile_job.py",
    "market:intraday:refresh-profiles": ".venv-ibkr-10.49/bin/python service/intraday_volume_profile_job.py --refresh-existing",
    "market:intraday:capture": ".venv-ibkr-10.49/bin/python service/intraday_shadow_capture.py capture",
    "market:intraday:status": ".venv-ibkr-10.49/bin/python service/intraday_shadow_capture.py status",
    "market:intraday:data-readiness": ".venv-ibkr-10.49/bin/python service/intraday_market_data_readiness.py",
    "market:evidence:capture": ".venv-ibkr-10.49/bin/python service/run_daily_evidence.py capture",
    "market:evidence:status": ".venv-ibkr-10.49/bin/python service/run_daily_evidence.py status",
    "market:evidence:report": ".venv-ibkr-10.49/bin/python service/run_daily_evidence.py report",
    "market:evidence:archive-performance": ".venv-ibkr-10.49/bin/python service/run_daily_evidence.py archive-performance",
    "market:evidence:readiness": ".venv-ibkr-10.49/bin/python service/run_daily_evidence.py readiness",
    "market:daily": "npm run market:refresh && npm run market:aggressive:refresh && npm run market:evidence:capture",
    "test:sec": "node --test service/sec_edgar.test.mjs service/recommendation_queue.test.mjs",
    "test:ledger": "node --test service/trading_ledger.test.mjs",
    "test:reconciliation": "node --test service/broker_reconciliation.test.mjs",
    "test:sizing": "node --test service/portfolio_sizing.test.mjs service/risk_policy.test.mjs",
    "test:risk": ".venv-ibkr-10.49/bin/python -m unittest discover -s service -p 'test_*.py' -v",
    "test:node": "node --test service/*.test.mjs",
    "test:python": "node scripts/run-python-tests.mjs",
    "test": "npm run typecheck && npm run test:node && npm run test:python",
    "qa": "npm test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/restyle": "^2.4.5",
    "expo": "^57.0.20",
    "expo-constants": "~57.0.17",
    "expo-device": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "phosphor-react-native": "^3.0.6",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "~19.2.10",
    "typescript": "~6.0.3"
  }
}
