# Safe template only. Never commit real tokens or credentials.
TRADE_APPROVAL_HOST=127.0.0.1
EXPO_PUBLIC_TRADE_API_URL=http://127.0.0.1:8787
TRADE_APPROVAL_APP_TOKEN=
EXPO_PUBLIC_TRADE_APP_TOKEN=
SEC_USER_AGENT=TradeApproval/0.1 your-email@example.com
# Alpaca Paper is the default execution broker. Set this to ibkr only for the
# legacy local Gateway/TWS connector.
TRADE_APPROVAL_BROKER_MODE=alpaca
ALPACA_ENABLE_PAPER_SUBMIT=true
ALPACA_ENABLE_RECONCILIATION=true
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
IBKR_ENABLE_WHAT_IF=false
IBKR_ENABLE_PAPER_SUBMIT=false
IBKR_ENABLE_AUTOMATIC_SELLS=false
# Default local connector: IB Gateway Paper (port 4002).
# Set IBKR_APPLICATION=tws for the explicit TWS Paper fallback (port 7497).
IBKR_APPLICATION=gateway
IBKR_HOST=127.0.0.1
# IBKR_PAPER_PORT=4002
# Read-only reconciliation runs every 5s with orders, 15s with positions, or 60s when quiet.
IBKR_ENABLE_RECONCILIATION=true
# These server-only credentials cover Alpaca Paper execution and market data.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
ALPACA_DATA_FEED=iex
